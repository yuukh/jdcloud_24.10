From: Codex <codex@openai.com>
Date: Sun, 26 Jul 2026 00:00:00 +0000
Subject: [PATCH] net: mediatek: preserve GSO for CPU-to-WiFi HNAT

The previous workaround segmented every CPU-to-WiFi GSO skb in
do_hnat_cpu_to_ge().  It avoided QDMA hardware TSO but increased CPU and
descriptor load, submitted each segment through dev_queue_xmit()
separately and still allowed the cached WiFi queue to become a QDMA QID.
Captures contain hardware-side repeats with identical IP ID and TCP
sequence even when TCP itself reports no retransmission.

Preserve the original GSO skb through qdisc and let the Ethernet QDMA
hardware perform TSO after the ordered QID normalization added by the
companion Ethernet patch.  One 64 KiB GSO skb now consumes one logical
QDMA TSO descriptor chain instead of roughly 44 independently submitted
wire-packet chains.

LOCAL_OUT has pulled the Ethernet header, so restore L2 and all header
offsets before reinjection.  Preserve CHECKSUM_PARTIAL, gso_size,
gso_segs, fragments and frag ownership unchanged.

VLAN insertion can replace skb->head, while HNAT stores its descriptor at
the start of that allocation.  Initialize HNAT metadata only after the
last possible head replacement.  Failures after L2 mutation consume the
skb instead of returning a modified skb to the bridge path.

Signed-off-by: Codex <codex@openai.com>
---
 .../ethernet/mediatek/mtk_hnat/hnat_nf_hook.c | 77 +++++++++++++------
 1 file changed, 51 insertions(+), 26 deletions(-)

diff --git a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
@@ -1003,41 +1003,66 @@ static unsigned int is_ppe_support_type(struct sk_buff *skb)
 
 static unsigned int do_hnat_cpu_to_ge(struct sk_buff *skb)
 {
+	u16 vlan_id;
+
 	if (unlikely(skb_shinfo(skb)->frag_list))
-                return -1;
+		return -1;
 	if (unlikely(skb->mark == HNAT_EXCEPTION_TAG))
-				return -1;
-	if (unlikely(skb_headroom(skb) < (FOE_INFO_LEN + ETH_HLEN))) {
-                if(unlikely(skb_cow(skb, FOE_INFO_LEN + ETH_HLEN)))
-                return -1;
-    }
+		return -1;
+	if (unlikely(skb_cow_head(skb, FOE_INFO_LEN + ETH_HLEN)))
+		return -1;
+
 	skb_hnat_alg(skb) = 0;
 	skb_hnat_magic_tag(skb) = HNAT_MAGIC_TAG;
 	skb_hnat_filled(skb) = 0;
 
 	if (unlikely(!is_ppe_support_type(skb))) {
 		skb_hnat_alg(skb) = 1;
-                return -1;
-        }
-        if (hnat_priv->g_ppdev && hnat_priv->g_ppdev->flags & IFF_UP) {
-                u16 vlan_id = 0;
-                skb_set_network_header(skb, 0);
-                skb_push(skb, ETH_HLEN);
-		set_to_ppe(skb);
-                vlan_id = skb_vlan_tag_get_id(skb);
-                if (unlikely(vlan_id)) {
-                        skb = vlan_insert_tag(skb, skb->vlan_proto, skb->vlan_tci);
-                        if (!skb)
-                                return -1;
-                }
+		return -1;
+	}
 
-                /*set where we come from */
-                __vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q), VLAN_CFI_MASK | (1234 & VLAN_VID_MASK));
-                skb->dev = hnat_priv->g_ppdev;
-                dev_queue_xmit(skb);
-     		return 0;
-        }
-	return -1;
+	if (unlikely(!hnat_priv->g_ppdev) ||
+	    unlikely(!(hnat_priv->g_ppdev->flags & IFF_UP)))
+		return -1;
+
+	/* LOCAL_OUT has pulled the Ethernet header.  Restore it while keeping
+	 * the network, transport, GSO and CHECKSUM_PARTIAL offsets relative to
+	 * the same head allocation.  QDMA can then perform TCP segmentation
+	 * after qdisc ordering, immediately before the packet enters PPE0.
+	 */
+	skb_set_network_header(skb, 0);
+	skb_push(skb, ETH_HLEN);
+	skb_reset_mac_header(skb);
+	skb_reset_mac_len(skb);
+
+	vlan_id = skb_vlan_tag_get_id(skb);
+	if (unlikely(vlan_id)) {
+		skb = vlan_insert_tag(skb, skb->vlan_proto, skb->vlan_tci);
+		if (!skb)
+			return 0;
+	}
+	skb_reset_mac_len(skb);
+
+	/* vlan_insert_tag() may replace skb->head.  HNAT stores its private
+	 * descriptor in that allocation, so initialize it only after the last
+	 * possible head replacement.  Do not alter GSO or checksum metadata.
+	 */
+	if (unlikely(skb_cow_head(skb, FOE_INFO_LEN))) {
+		dev_kfree_skb_any(skb);
+		return 0;
+	}
+
+	memset(skb_hnat_info(skb), 0, FOE_INFO_LEN);
+	skb_hnat_magic_tag(skb) = HNAT_MAGIC_TAG;
+	set_to_ppe(skb);
+
+	/* Mark the Ethernet PPE reinjection source. */
+	__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q),
+			       VLAN_CFI_MASK | (1234 & VLAN_VID_MASK));
+	skb->dev = hnat_priv->g_ppdev;
+	dev_queue_xmit(skb);
+
+	return 0;
 }
 static void mtk_hnat_nf_update(struct sk_buff *skb)
 {
-- 
2.45.0
