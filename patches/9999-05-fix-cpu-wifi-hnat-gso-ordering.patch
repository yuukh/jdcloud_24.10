From: Codex <codex@openai.com>
Date: Sat, 25 Jul 2026 00:00:00 +0000
Subject: [PATCH] net: mediatek: safely segment CPU-to-WiFi HNAT GSO

Local TCP output reaches do_hnat_cpu_to_ge() as non-linear GSO skbs,
normally with 44 wire segments.  Client-side captures show sequence holes
of 44 MSS and multiples thereof once more than one such skb is in flight.
The packets inside either batch have valid TCP checksums and monotonically
increasing IP IDs, but complete batches are interleaved after crossing the
QDMA hardware-TSO to PPE/WED boundary.  The same path is almost clean at
10 Mbit/s, where GSO batches do not overlap, and UDP datagrams do not
exhibit the failure.

Force complete software segmentation only on the CPU-to-WiFi PPE
reinjection path.  Keep SG and checksum offload enabled for the resulting
wire-sized skbs.

The Ethernet header has already been pulled when the bridge local-out hook
runs.  It must be pushed before skb_gso_segment(); otherwise GSO resets the
MAC header to the IPv4 header and allocates segments whose preceding
headroom contains no Ethernet header.  Pushing ETH_HLEN on those new skbs
then transmits uninitialized bytes as destination/source MAC addresses.

GSO also allocates fresh skb heads, while this HNAT driver stores its
descriptor at skb->head.  In addition, HNAT_SKB_CB2 is at skb->cb[44],
inside Linux's GSO scratch control block at skb->cb[32..47].  Initialize
both metadata areas for every segment after GSO and after any VLAN head
replacement.  Submit the already L2-ready segments directly instead of
recursing through a function that expects skb->data at the network header.
Use skb_cow_head() before writing the head descriptor so cloned headers
cannot be modified through a shared allocation.

On segmentation error, consume the original skb just like the networking
core does.  Returning it to the bridge path would reuse an skb whose MAC
header and control block have already been used as GSO workspace.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c | 112 ++++++++++++++++---
 1 file changed, 86 insertions(+), 28 deletions(-)

diff --git a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
@@ -26,6 +26,7 @@
 #include <net/udp.h>
 #include <net/netfilter/nf_conntrack.h>
 #include <net/netfilter/nf_conntrack_acct.h>
+#include <net/gso.h>
 #include "nf_hnat_mtk.h"
 #include "hnat.h"
 
@@ -1001,44 +1002,101 @@
 	return 0;
 }
 
+static void hnat_cpu_to_ge_xmit(struct sk_buff *skb)
+{
+	u16 vlan_id = skb_vlan_tag_get_id(skb);
+
+	if (unlikely(vlan_id)) {
+		skb = vlan_insert_tag(skb, skb->vlan_proto, skb->vlan_tci);
+		if (!skb)
+			return;
+	}
+
+	/* vlan_insert_tag() may replace skb->head.  Initialize the vendor
+	 * metadata only after it, so every segment queued to PPE owns a valid
+	 * descriptor at the beginning of its current head allocation.
+	 */
+	if (unlikely(skb_cow_head(skb, FOE_INFO_LEN))) {
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	memset(skb_hnat_info(skb), 0, FOE_INFO_LEN);
+	skb_hnat_magic_tag(skb) = HNAT_MAGIC_TAG;
+	set_to_ppe(skb);
+
+	/* Set where the reinjected packet came from. */
+	__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q),
+			       VLAN_CFI_MASK | (1234 & VLAN_VID_MASK));
+	skb->dev = hnat_priv->g_ppdev;
+	dev_queue_xmit(skb);
+}
+
 static unsigned int do_hnat_cpu_to_ge(struct sk_buff *skb)
 {
+	struct sk_buff *segs, *seg, *next;
+	netdev_features_t features;
+
 	if (unlikely(skb_shinfo(skb)->frag_list))
-                return -1;
+		return -1;
 	if (unlikely(skb->mark == HNAT_EXCEPTION_TAG))
-				return -1;
-	if (unlikely(skb_headroom(skb) < (FOE_INFO_LEN + ETH_HLEN))) {
-                if(unlikely(skb_cow(skb, FOE_INFO_LEN + ETH_HLEN)))
-                return -1;
-    }
+		return -1;
+	if (unlikely(skb_cow_head(skb, FOE_INFO_LEN + ETH_HLEN)))
+		return -1;
+
+	memset(skb_hnat_info(skb), 0, FOE_INFO_LEN);
-	skb_hnat_alg(skb) = 0;
 	skb_hnat_magic_tag(skb) = HNAT_MAGIC_TAG;
-	skb_hnat_filled(skb) = 0;
 
 	if (unlikely(!is_ppe_support_type(skb))) {
 		skb_hnat_alg(skb) = 1;
-                return -1;
-        }
-        if (hnat_priv->g_ppdev && hnat_priv->g_ppdev->flags & IFF_UP) {
-                u16 vlan_id = 0;
-                skb_set_network_header(skb, 0);
-                skb_push(skb, ETH_HLEN);
-		set_to_ppe(skb);
-                vlan_id = skb_vlan_tag_get_id(skb);
-                if (unlikely(vlan_id)) {
-                        skb = vlan_insert_tag(skb, skb->vlan_proto, skb->vlan_tci);
-                        if (!skb)
-                                return -1;
-                }
+		return -1;
+	}
 
-                /*set where we come from */
-                __vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q), VLAN_CFI_MASK | (1234 & VLAN_VID_MASK));
-                skb->dev = hnat_priv->g_ppdev;
-                dev_queue_xmit(skb);
-     		return 0;
-        }
-	return -1;
+	if (unlikely(!hnat_priv->g_ppdev) ||
+	    unlikely(!(hnat_priv->g_ppdev->flags & IFF_UP)))
+		return -1;
+
+	/* The bridge hook has pulled the Ethernet header.  Put it back before
+	 * GSO so skb_segment() copies real L2 bytes into every new skb.
+	 */
+	skb_set_network_header(skb, 0);
+	skb_push(skb, ETH_HLEN);
+	skb_reset_mac_header(skb);
+	skb_reset_mac_len(skb);
+
+	if (!skb_is_gso(skb)) {
+		hnat_cpu_to_ge_xmit(skb);
+		return 0;
+	}
+
+	/* Avoid carrying a multi-segment hardware-TSO batch across the
+	 * QDMA-to-PPE/WED boundary.  Keep SG and checksum offload for each
+	 * wire-sized skb.  GSO uses skb->cb[32..47] and allocates fresh skb
+	 * heads, so restore both MediaTek metadata areas after segmentation.
+	 */
+	features = hnat_priv->g_ppdev->features & ~NETIF_F_GSO_MASK;
+	segs = skb_gso_segment(skb, features);
+	if (IS_ERR(segs)) {
+		pr_warn_ratelimited("HNAT: CPU-to-WiFi GSO segmentation failed: %ld\n",
+				    PTR_ERR(segs));
+		dev_kfree_skb_any(skb);
+		return 0;
+	}
+
+	if (!segs) {
+		hnat_cpu_to_ge_xmit(skb);
+		return 0;
+	}
+
+	consume_skb(skb);
+	skb_list_walk_safe(segs, seg, next) {
+		skb_mark_not_on_list(seg);
+		hnat_cpu_to_ge_xmit(seg);
+	}
+
+	return 0;
 }
+
 static void mtk_hnat_nf_update(struct sk_buff *skb)
 {
 	struct nf_conn *ct;
-- 
