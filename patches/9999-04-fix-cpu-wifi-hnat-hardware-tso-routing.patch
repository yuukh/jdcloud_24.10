From: Codex <codex@openai.com>
Date: Sun, 26 Jul 2026 00:00:00 +0000
Subject: [PATCH] net: mediatek: serialize CPU-to-WiFi HNAT hardware TSO

CPU-local traffic is first queued for the WiFi netdev.  The TCP socket
therefore caches a WiFi TX queue in sk_tx_queue_mapping.  HNAT later
redirects the same skb to the Ethernet QDMA device.  Since that queue
number is also valid on the 64-queue Ethernet device, netdev_pick_tx()
keeps it and the driver interprets a WiFi queue as a QDMA hardware QID.

Normalize only CPU-to-PPE skbs to queue zero after qdisc dequeue.  Doing
this before descriptor construction keeps QDMA QID, BQL sent accounting
and DMA completion accounting on the same netdev queue.

Hardware TSO captures show a second ordering boundary.  The individual
segments within a GSO skb are almost always ordered, but complete 64 KiB
TSO expansions overtake and interleave with other expansions after QDMA
hands them to PPE/WED.  In three ten-second captures, 5.96% to 10.10% of
unique TCP segments arrived behind the receive high-water mark and most
client ACKs carried SACK.  The reordered blocks commonly contain exactly
44 MSS-sized packets, matching one full GSO skb.

Keep hardware TSO and SG enabled, but allow only one CPU-to-PPE hardware
TSO descriptor chain in flight.  Mark its final descriptor and release
the gate from QDMA completion, after all source fragments have been
consumed.  Stop queue zero while the gate is occupied and use the normal
stop/recheck/wake pattern to avoid a missed completion wakeup.  Packets
already behind a TSO chain wait as well, so a small TCP skb cannot cross
the expansion.  UDP, non-HNAT and normal Ethernet traffic are unchanged.

Every QDMA SG descriptor has its own FPORT, so route the complete
descriptor chain to PPE0.  Publish every HNAT hardware-TSO skb at its own
QDMA context-pointer boundary.  Name the private CPU-to-PPE marker shared
by HNAT and Ethernet instead of duplicating its numeric value.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c        | 109 +++++++++++++++++++--
 drivers/net/ethernet/mediatek/mtk_eth_soc.h        |   3 +
 .../net/ethernet/mediatek/mtk_hnat/nf_hnat_mtk.h  |   3 +-
 3 files changed, 107 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.c b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
index bbdf31d..fca6920 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -1662,6 +1662,11 @@ static int txd_to_idx(struct mtk_tx_ring *ring, void *dma, u32 txd_size)
 static void mtk_tx_unmap(struct mtk_eth *eth, struct mtk_tx_buf *tx_buf,
 			 struct xdp_frame_bulk *bq, bool napi)
 {
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+	bool hnat_tso_last = tx_buf->flags & MTK_TX_FLAGS_HNAT_TSO_LAST;
+	u16 mac_id = tx_buf->mac_id;
+#endif
+
 	if (MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA)) {
 		if (tx_buf->flags & MTK_TX_FLAGS_SINGLE0) {
 			dma_unmap_single(eth->dma_dev,
@@ -1711,6 +1716,15 @@ static void mtk_tx_unmap(struct mtk_eth *eth, struct mtk_tx_buf *tx_buf,
 	}
 	tx_buf->flags = 0;
 	tx_buf->data = NULL;
+
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+	if (hnat_tso_last &&
+	    atomic_xchg(&eth->hnat_tso_pending, 0) &&
+	    napi && mac_id < MTK_MAX_DEVS && eth->netdev[mac_id] &&
+	    !test_bit(MTK_RESETTING, &eth->state) &&
+	    atomic_read(&eth->tx_ring.free_count) > eth->tx_ring.thresh)
+		netif_tx_wake_queue(netdev_get_tx_queue(eth->netdev[mac_id], 0));
+#endif
 }
 
 static void setup_tx_buf(struct mtk_eth *eth, struct mtk_tx_buf *tx_buf,
@@ -1855,6 +1869,7 @@ static int mtk_tx_map(struct sk_buff *skb, struct net_device *dev,
 	struct mtk_tx_dma *itxd_pdma, *txd_pdma;
 	struct mtk_tx_buf *itx_buf, *tx_buf;
 	int i, n_desc = 1;
+	bool hnat_to_ppe = false;
 	int queue = skb_get_queue_mapping(skb);
 	int k = 0;
 
@@ -1882,10 +1897,12 @@ static int mtk_tx_map(struct sk_buff *skb, struct net_device *dev,
 	/* TX SG offload */
 	txd = itxd;
 	txd_pdma = qdma_to_pdma(ring, txd);
-	#if defined(CONFIG_NET_MEDIATEK_HNAT) || defined(CONFIG_NET_MEDIATEK_HNAT_MODULE)
-	if (HNAT_SKB_CB2(skb)->magic == 0x78681415) {
-		txd->txd4 &= ~(0xf << TX_DMA_FPORT_SHIFT_V2);
-		txd->txd4 |= 0x3 << TX_DMA_FPORT_SHIFT_V2;
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+	if (HNAT_SKB_CB2(skb)->magic == HNAT_TO_PPE_MAGIC) {
+		hnat_to_ppe = true;
+		txd->txd4 &= ~(TX_DMA_FPORT_MASK_V2 <<
+			       TX_DMA_FPORT_SHIFT_V2);
+		txd->txd4 |= PSE_PPE0_PORT << TX_DMA_FPORT_SHIFT_V2;
 	}
 #endif
 
@@ -1923,6 +1940,17 @@ static int mtk_tx_map(struct sk_buff *skb, struct net_device *dev,
 
 			mtk_tx_set_dma_desc(dev, txd, &txd_info);
 
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+			/* A QDMA SG descriptor carries its own destination.
+			 * Keep the complete TSO packet on PPE0.
+			 */
+			if (hnat_to_ppe) {
+				txd->txd4 &= ~(TX_DMA_FPORT_MASK_V2 <<
+					       TX_DMA_FPORT_SHIFT_V2);
+				txd->txd4 |= PSE_PPE0_PORT <<
+					     TX_DMA_FPORT_SHIFT_V2;
+			}
+#endif
 			tx_buf = mtk_desc_to_tx_buf(ring, txd,
 						    soc->tx.desc_size);
 			if (new_desc)
@@ -1943,6 +1971,13 @@ static int mtk_tx_map(struct sk_buff *skb, struct net_device *dev,
 	itx_buf->type = MTK_TYPE_SKB;
 	itx_buf->data = skb;
 
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+	if (hnat_to_ppe && gso && MTK_HAS_CAPS(soc->caps, MTK_QDMA)) {
+		tx_buf = mtk_desc_to_tx_buf(ring, txd, soc->tx.desc_size);
+		tx_buf->flags |= MTK_TX_FLAGS_HNAT_TSO_LAST;
+	}
+#endif
+
 	if (!MTK_HAS_CAPS(soc->caps, MTK_QDMA)) {
 		if (k & 0x1)
 			txd_pdma->txd2 |= TX_DMA_LS0;
@@ -1962,7 +1997,8 @@ static int mtk_tx_map(struct sk_buff *skb, struct net_device *dev,
 	wmb();
 
 	if (MTK_HAS_CAPS(soc->caps, MTK_QDMA)) {
-		if (netif_xmit_stopped(txq) || !netdev_xmit_more())
+		if ((hnat_to_ppe && gso) || netif_xmit_stopped(txq) ||
+		    !netdev_xmit_more())
 			mtk_w32(eth, txd->txd2, soc->reg_map->qdma.ctx_ptr);
 	} else {
 		int next_idx;
@@ -2059,6 +2095,32 @@ static netdev_tx_t mtk_start_xmit(struct sk_buff *skb, struct net_device *dev)
 	struct sk_buff *segs, *next;
 	bool gso = false;
 	int tx_num;
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+	bool hnat_to_ppe = false;
+	bool hnat_tcp = false;
+	bool hnat_tso = false;
+#endif
+
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+	/* The local socket cached a queue for the WiFi netdev before HNAT
+	 * redirected this skb to the Ethernet QDMA device.  That queue number
+	 * is valid on both devices, so the core does not discard it.  It has
+	 * no QDMA traffic-class meaning and lets successive TSO batches enter
+	 * independently scheduled hardware queues.
+	 *
+	 * Normalize the mapping after qdisc dequeue.  The skb retains queue 0
+	 * through DMA completion, keeping descriptor QID and BQL accounting
+	 * on the same queue.
+	 */
+	if (HNAT_SKB_CB2(skb)->magic == HNAT_TO_PPE_MAGIC) {
+		hnat_to_ppe = true;
+		if (skb->protocol == htons(ETH_P_IP))
+			hnat_tcp = ip_hdr(skb)->protocol == IPPROTO_TCP;
+		else if (skb->protocol == htons(ETH_P_IPV6))
+			hnat_tcp = ipv6_hdr(skb)->nexthdr == IPPROTO_TCP;
+		skb_set_queue_mapping(skb, 0);
+	}
+#endif
 
 	if (skb_vlan_tag_present(skb) &&
 	    !eth_proto_is_802_3(eth_hdr(skb)->h_proto)) {
@@ -2112,12 +2174,44 @@ static netdev_tx_t mtk_start_xmit(struct sk_buff *skb, struct net_device *dev)
 		}
 	}
 
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+	/* QDMA can have several TSO expansions in flight at once.  That is
+	 * normally harmless for a MAC destination, but PPE/WED may dispatch
+	 * complete 64 KiB expansions independently and let a later expansion
+	 * overtake an earlier one.  Keep one CPU-to-PPE TSO chain in flight.
+	 * The final descriptor releases this gate from the QDMA completion
+	 * path, after every source fragment of the expansion is consumed.
+	 */
+	hnat_tcp |= gso;
+	hnat_tso = hnat_to_ppe && hnat_tcp && gso &&
+		   MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA);
+	if (hnat_to_ppe && hnat_tcp &&
+	    atomic_read(&eth->hnat_tso_pending)) {
+		struct netdev_queue *txq = netdev_get_tx_queue(dev, 0);
+
+		netif_tx_stop_queue(txq);
+		/* Avoid missing a completion between stop and recheck. */
+		smp_mb();
+		if (!atomic_read(&eth->hnat_tso_pending))
+			netif_tx_wake_queue(txq);
+		spin_unlock(&eth->page_lock);
+
+		return NETDEV_TX_BUSY;
+	}
+	if (hnat_tso)
+		atomic_set(&eth->hnat_tso_pending, 1);
+#endif
+
 	skb_list_walk_safe(skb, skb, next) {
 		if ((mtk_is_netsys_v1(eth) &&
 		     mtk_skb_has_small_frag(skb) && skb_linearize(skb)) ||
 		    mtk_tx_map(skb, dev, tx_num, ring, gso) < 0) {
-				stats->tx_dropped++;
-				dev_kfree_skb_any(skb);
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT)
+			if (hnat_tso)
+				atomic_set(&eth->hnat_tso_pending, 0);
+#endif
+			stats->tx_dropped++;
+			dev_kfree_skb_any(skb);
 		}
 	}
 
@@ -6492,6 +6586,7 @@ static int mtk_probe(struct platform_device *pdev)
 	spin_lock_init(&eth->rx_irq_lock);
 	spin_lock_init(&eth->dim_lock);
 	spin_lock_init(&eth->qdma_shaper.lock);
+	atomic_set(&eth->hnat_tso_pending, 0);
 
 	eth->rx_dim.mode = DIM_CQ_PERIOD_MODE_START_FROM_EQE;
 	INIT_WORK(&eth->rx_dim.work, mtk_dim_rx);
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.h b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
index 69b0039..92ec75c 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.h
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
@@ -941,6 +941,7 @@ enum mtk_tx_flags {
 	 */
 	MTK_TX_FLAGS_SINGLE0	= 0x01,
 	MTK_TX_FLAGS_PAGE0	= 0x02,
+	MTK_TX_FLAGS_HNAT_TSO_LAST = 0x04,
 };
 
 /* This enum allows us to identify how the clock is defined on the array of the
@@ -1646,6 +1647,7 @@ struct mtk_soc_data {
  * @mii_bus:		If there is a bus we need to create an instance for it
  * @pending_work:	The workqueue used to reset the dma ring
  * @state:		Initialization and runtime state of the device
+ * @hnat_tso_pending:	Serializes CPU-to-PPE hardware TSO descriptor chains
  * @soc:		Holding specific data among vaious SoCs
  */
 
@@ -1688,6 +1690,7 @@ struct mtk_eth {
 	struct mii_bus			*mii_bus;
 	struct work_struct		pending_work;
 	unsigned long			state;
+	atomic_t			hnat_tso_pending;
 
 	const struct mtk_soc_data	*soc;
 
diff --git a/drivers/net/ethernet/mediatek/mtk_hnat/nf_hnat_mtk.h b/drivers/net/ethernet/mediatek/mtk_hnat/nf_hnat_mtk.h
index c5dbea1..06532dd 100644
--- a/drivers/net/ethernet/mediatek/mtk_hnat/nf_hnat_mtk.h
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/nf_hnat_mtk.h
@@ -91,9 +91,10 @@ struct hnat_desc {
 	(((skb_hnat_sport(skb) == NR_GMAC2_PORT) && (CFG_PPE_NUM >= 2)) ? 1 : 0)
 #define do_ext2ge_fast_try(dev, skb)						\
 	(IS_EXT(dev) && !is_from_extge(skb) && !IS_WHNAT(dev))
+#define HNAT_TO_PPE_MAGIC 0x78681415
 #define set_from_extge(skb) (HNAT_SKB_CB2(skb)->magic = 0x78786688)
 #define clr_from_extge(skb) (HNAT_SKB_CB2(skb)->magic = 0x0)
-#define set_to_ppe(skb) (HNAT_SKB_CB2(skb)->magic = 0x78681415)
+#define set_to_ppe(skb) (HNAT_SKB_CB2(skb)->magic = HNAT_TO_PPE_MAGIC)
 #define is_from_extge(skb) (HNAT_SKB_CB2(skb)->magic == 0x78786688)
 #define is_hnat_info_filled(skb) (skb_hnat_filled(skb) == HNAT_INFO_FILLED)
 #define is_magic_tag_valid(skb) (skb_hnat_magic_tag(skb) == HNAT_MAGIC_TAG)
-- 
