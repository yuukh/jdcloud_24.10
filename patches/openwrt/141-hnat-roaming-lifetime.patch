+static int hnat_roam_handler(void *data)
+{
+	struct socket *sock = data;
+	u8 rcv_buf[512] __aligned(NLMSG_ALIGNTO);
+	int len, ret;
+
+	while (!kthread_should_stop()) {
+		struct msghdr msg = {};
+		struct kvec iov = {
+			.iov_base = rcv_buf,
+			.iov_len = sizeof(rcv_buf),
+		};
+
+		/* A blocking recvmsg cannot observe kthread_stop(). Sleep on the
+		 * receive queue with an explicit stop condition, then receive without
+		 * blocking so teardown can join the thread before releasing its socket.
+		 */
+		ret = wait_event_interruptible(*sk_sleep(sock->sk),
+			kthread_should_stop() ||
+			!skb_queue_empty_lockless(&sock->sk->sk_receive_queue));
+		if (kthread_should_stop())
+			break;
+		if (ret)
+			continue;
 
