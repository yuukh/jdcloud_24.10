-	len -= NLMSG_LENGTH(sizeof(struct ndmsg));
-	while (nla_ok(nla, len)) {
-		if (nla_type(nla) == NDA_LLADDR) {
-			entry_delete_by_mac(nla_data(nla));
-		}
-		nla = nla_next(nla, &len);
+		len = kernel_recvmsg(sock, &msg, &iov, 1, iov.iov_len,
+				     MSG_DONTWAIT);
+		if (len > 0 && !(msg.msg_flags & MSG_TRUNC))
+			hnat_roaming_notify(rcv_buf, len);
 	}
 
