+static int hnat_alloc_tables(void)
+{
+	int etry_num_cfg, i;
+
+	/* All PPEs share the software table geometry. Allocate the complete
+	 * set before starting hardware, and discard a failed set before reducing
+	 * its size so both hardware indexing and DMA frees use the same length.
+	 */
+	for (etry_num_cfg = DEF_ETRY_NUM_CFG; etry_num_cfg >= TABLE_1K;
+	     etry_num_cfg--) {
+		hnat_priv->etry_num_cfg = etry_num_cfg;
+		hnat_priv->foe_etry_num =
+			DEF_ETRY_NUM >> (DEF_ETRY_NUM_CFG - etry_num_cfg);
+
+		for (i = 0; i < CFG_PPE_NUM; i++) {
+			if (hnat_alloc_table(i))
+				break;
+		}
+		if (i == CFG_PPE_NUM)
+			return 0;
+
+		for (i = 0; i < CFG_PPE_NUM; i++)
+			hnat_free_tables(i);
+	}
+
+	return -ENOMEM;
+}
+
+static int hnat_start(u32 ppe_id)
+{
+	size_t foe_table_sz = hnat_priv->foe_etry_num * sizeof(struct foe_entry);
+	size_t foe_mib_tb_sz = hnat_priv->foe_etry_num * sizeof(struct mib_entry);
+
+	if (ppe_id >= CFG_PPE_NUM || !hnat_priv->foe_table_cpu[ppe_id])
+		return -EINVAL;
+
+	dev_info(hnat_priv->dev, "PPE%d entry number = %d\n",
+		 ppe_id, hnat_priv->foe_etry_num);
+	memset(hnat_priv->foe_table_cpu[ppe_id], 0, foe_table_sz);
+	if (hnat_priv->data->version == MTK_HNAT_V1)
+		exclude_boundary_entry(hnat_priv->foe_table_cpu[ppe_id]);
+	writel(hnat_priv->foe_table_dev[ppe_id], hnat_priv->ppe_base[ppe_id] + PPE_TB_BASE);
+
+	if (hnat_priv->data->per_flow_accounting) {
+		memset(hnat_priv->foe_mib_cpu[ppe_id], 0, foe_mib_tb_sz);
+		writel(hnat_priv->foe_mib_dev[ppe_id],
+		       hnat_priv->ppe_base[ppe_id] + PPE_MIB_TB_BASE);
+	}
+
+	return hnat_hw_init(ppe_id);
+}
