--- /dev/null
+++ b/feeds/packages/net/miniupnpd/files/miniupnpd.firewall
@@ -0,0 +1,21 @@
+#!/bin/sh
+
+SERVICE=/etc/init.d/miniupnpd
+
+# The firewall event is global. Only touch miniupnpd if it was already
+# running; in particular, never start a disabled/stopped service here.
+"$SERVICE" running || exit 0
+command -v nft >/dev/null 2>&1 || exit 0
+
+# A normal fw4 rebuild recreates these static chains before emitting the
+# event. Refuse to restart if they are absent so miniupnpd cannot trigger a
+# compensating fw4 reload and enter a firewall <-> miniupnpd reload loop.
+for chain in upnp_forward upnp_prerouting upnp_postrouting; do
+	nft -s -t -n list chain inet fw4 "$chain" >/dev/null 2>&1 || {
+		logger -t miniupnpd "fw4 reload completed without $chain; skip automatic resync"
+		exit 0
+	}
+done
+
+logger -t miniupnpd "fw4 ruleset rebuilt; restarting to restore dynamic mappings"
+exec "$SERVICE" restart
