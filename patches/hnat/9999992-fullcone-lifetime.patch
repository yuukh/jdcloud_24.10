Subject: netfilter: keep confirmed full-cone conntracks immutable and bound port search

The vendor full-cone branch treats NF_ACCEPT from nf_nat_setup_info() as
permission to add a helper. For confirmed connections that verdict means no
setup was done; adding an extension can reallocate memory used by readers.
Keep that guard inside the full-cone UDP path so ordinary MASQUERADE behavior
is unchanged when full-cone NAT is disabled. Also avoid a u16 wrap at port
65535 while holding the expectation spinlock.

--- a/net/netfilter/nf_nat_masquerade.c
+++ b/net/netfilter/nf_nat_masquerade.c
@@ -199,1 +199,8 @@ nf_nat_masquerade_ipv4(struct sk_buff *skb, unsigned int hooknum,
                struct nf_conntrack_expect *exp;
+               /* nf_nat_setup_info() accepts confirmed conntracks without
+                * changing them. Do not treat that verdict as permission to
+                * attach the full-cone helper to immutable shared state.
+                */
+               if (nf_ct_is_confirmed(ct))
+                       return NF_ACCEPT;
+
@@ -209,7 +216,8 @@ nf_nat_masquerade_ipv4(struct sk_buff *skb, unsigned int hooknum,
                        pr_debug("bcm_nat: existing mapped port = %hu\n",
                                 ntohs(minport));
                } else { /* no previous expect */
-                       u_int16_t newport, tmpport, orgport;
+                       unsigned int newport, tmpport;
+                       u_int16_t orgport;
 
                        minport = range->min_proto.all == 0?
                                ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.
@@ -226,5 +234,12 @@ nf_nat_masquerade_ipv4(struct sk_buff *skb, unsigned int hooknum,
                                        break;
                                }
                        }
+                       /* Never wrap and scan forever under the BH lock,
+                        * or silently use an occupied/out-of-range port.
+                        */
+                       if (newport > tmpport) {
+                               spin_unlock_bh(&nf_conntrack_expect_lock);
+                               return NF_DROP;
+                       }
                }
                spin_unlock_bh(&nf_conntrack_expect_lock);

