+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MTK_HNAT_CPU_H
+#define MTK_HNAT_CPU_H
+
+/* Packet memory is recycled: a valid tag in skb->head (or cb[44])
+ * is not proof of ingress. RX supplies skb_iif; artificial PPE return
+ * additionally carries offload_no_fdb. Never consult stale headroom
+ * to decide whether a locally generated packet should use the PPE.
+ */
+static bool hnat_cpu_has_ingress_port(const struct sk_buff *skb)
+{
+	return skb->skb_iif || skb->offload_no_fdb;
+}
+
+static bool hnat_cpu_from_extge(const struct sk_buff *skb)
+{
+	return hnat_cpu_has_ingress_port(skb) && is_from_extge(skb);
+}
+
+static bool hnat_cpu_has_valid_info(const struct sk_buff *skb)
+{
+	return hnat_cpu_has_ingress_port(skb) &&
+	       IS_SPACE_AVAILABLE_HEAD(skb) && is_magic_tag_valid(skb);
+}
+
+static bool hnat_cpu_has_ingress_info(const struct sk_buff *skb)
+{
+	if (!hnat_cpu_has_valid_info(skb))
+		return false;
+
+	return FROM_GE_PPD(skb) || FROM_GE_LAN(skb) || FROM_GE_WAN(skb) ||
+	       FROM_WED(skb) || FROM_EXT(skb) || FROM_GE_VIRTUAL(skb);
+}
+
+/* Called at the bridge output hook, with skb->data at the network header.
+ * Check eligibility before changing the skb: a bypass must leave it intact.
+ */
+static bool hnat_cpu_packet_supported(const struct sk_buff *skb)
+{
+	struct ipv6hdr ip6buf;
+	struct iphdr ipbuf;
+	const struct ipv6hdr *ip6h;
+	const struct iphdr *iph;
+
+	if (!skb_mac_header_was_set(skb) ||
+	    skb_headroom(skb) < ETH_HLEN ||
+	    skb_mac_header(skb) != skb->data - ETH_HLEN ||
+	    skb_network_offset(skb) || skb->encapsulation ||
+	    skb_shinfo(skb)->frag_list ||
+	    is_multicast_ether_addr(eth_hdr(skb)->h_dest))
+		return false;
+
+	switch (skb->protocol) {
+	case htons(ETH_P_IP):
+		iph = skb_header_pointer(skb, 0, sizeof(ipbuf), &ipbuf);
+		return iph && iph->version == 4 && iph->ihl == 5 &&
+		       !ip_is_fragment(iph) &&
+		       (iph->protocol == IPPROTO_TCP ||
+			iph->protocol == IPPROTO_UDP);
+	case htons(ETH_P_IPV6):
+		ip6h = skb_header_pointer(skb, 0, sizeof(ip6buf), &ip6buf);
+		return ip6h && ip6h->version == 6 &&
+		       (ip6h->nexthdr == IPPROTO_TCP ||
+			ip6h->nexthdr == IPPROTO_UDP);
+	default:
+		return false;
+	}
+}
+
+/* Return a netfilter verdict, not a private success/failure code.  Until
+ * dev_queue_xmit(), the caller owns skb, including every error path.
+ */
+static unsigned int do_hnat_cpu_to_ge(struct sk_buff *skb)
+{
+	struct net_device *dev = READ_ONCE(hnat_priv->g_ppdev);
+	unsigned int headroom = FOE_INFO_LEN + ETH_HLEN;
+	bool tagged = skb_vlan_tag_present(skb);
+
+	if (skb->mark == HNAT_EXCEPTION_TAG || !dev ||
+	    !(READ_ONCE(dev->flags) & IFF_UP) ||
+	    !hnat_cpu_packet_supported(skb))
+		return NF_ACCEPT;
+
+	if (tagged)
+		headroom += VLAN_HLEN;
+
+	/* TCP may retain a payload-only clone in its retransmit queue.  We
+	 * write private metadata at skb->head, so skb_cow_head() is not
+	 * sufficient: unshare even when the transport header is writable.
+	 * skb_cow() preserves page fragments and hardware TSO/SG.
+	 */
+	if (skb_cow(skb, headroom))
+		return NF_DROP;
+
+	memset(skb_hnat_info(skb), 0, FOE_INFO_LEN);
+	skb_hnat_magic_tag(skb) = HNAT_MAGIC_TAG;
+	skb_push(skb, ETH_HLEN);
+	skb_reset_mac_header(skb);
+
+	/* Preserve priority-tagged VID 0 as well as ordinary VLAN tags.
+	 * Use the non-consuming API: NF_DROP will free skb on failure.
+	 */
+	if (tagged) {
+		if (__vlan_insert_tag(skb, skb->vlan_proto,
+				      skb_vlan_tag_get(skb)))
+			return NF_DROP;
+		skb->protocol = skb->vlan_proto;
+	}
+
+	set_to_ppe(skb);
+	/* VLAN presence is represented by vlan_proto in this kernel.  Do not
+	 * set the on-wire DEI bit (VLAN_CFI_MASK) as an old presence marker.
+	 */
+	__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q), 1234);
+	skb->dev = dev;
+	dev_queue_xmit(skb);
+	return NF_STOLEN;
+}
